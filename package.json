{
  "name": "treasure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "oxfmt ./src",
    "type-check": "tsc -b --noEmit",
    "map-data": "node scripts/generate-map-data.ts",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "gsap": "^3.15.0",
    "howler": "^2.2.4",
    "lucide-react": "^1.40.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "lint-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern"
  }
